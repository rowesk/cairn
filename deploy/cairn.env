# Settings for the Cairn service. Each variable matches a flag: CAIRN_LISTEN is
# -listen, CAIRN_PUBLIC_BASE_URL is -public-base-url, and so on. A flag on the
# command line wins over its variable, and empty values are ignored.
# Run `cairn help` for the full list. Restart Cairn after a change:
#   sudo systemctl restart cairn

# Private library address: 127.0.0.1, or this machine's Tailscale IP.
CAIRN_LISTEN=127.0.0.1:8080

# The address you and your agents open the library at, such as
# https://cairn.example.ts.net. The API uses it for full page links.
CAIRN_PRIVATE_BASE_URL=

# Other names you open the library at, separated by commas, such as
# cairn.home.example. IP addresses, localhost, tailnet names and the private
# base URL always work. Cairn refuses any other name, so a website cannot
# reach the library by pointing its own name at this machine.
CAIRN_ALLOWED_HOSTS=

# Sharing by public link. Set both, or leave both empty. See docs/sharing.md.
CAIRN_PUBLIC_LISTEN=
CAIRN_PUBLIC_BASE_URL=

# Send to Kindle. See docs/kindle.md. Leave all four empty to turn it off.
CAIRN_MAIL_FROM=
CAIRN_SMTP_SERVER=
CAIRN_SMTP_USERNAME=
CAIRN_SMTP_PASSWORD_FILE=

# cairn.service already passes these as flags, so they take no effect here:
# CAIRN_DATA=/var/lib/cairn
# CAIRN_PUBLISHER_TOKEN_FILE=/var/lib/cairn/publisher-token
