[Unit]
Description=Cairn private report library
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cairn
Group=cairn
StateDirectory=cairn
StateDirectoryMode=0700
EnvironmentFile=/etc/cairn/cairn.env
# Cairn reads CAIRN_LISTEN, CAIRN_PUBLIC_* and the mail settings from the environment file itself.
ExecStart=/usr/local/bin/cairn -data /var/lib/cairn -publisher-token-file /var/lib/cairn/publisher-token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
